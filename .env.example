PORT=3001

# Supabase — Project Settings → Database → Connection string
# Use a URL do pooler (porta 6543) aqui:
DATABASE_URL=postgresql://postgres.xxx:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# URL direta (porta 5432) — usada pelo Prisma para migrations
DIRECT_URL=postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres

JWT_SECRET=troque_por_uma_chave_secreta_forte_aqui

# URLs do frontend separadas por vírgula
CORS_ORIGIN=http://localhost:5173,https://seusite.netlify.app
